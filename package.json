{
  "name": "loveur.life",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "analyze": "next experimental-analyze --output",
    "start": "next start",
    "prod": "next build",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --project=\"desktop-*\" --project=\"mobile-*\" --project=webkit-mobile",
    "test:firefox": "playwright test --project=firefox",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.+(js|mjs|cjs|jsx|ts|tsx)": [
      "prettier --write"
    ],
    "*.+(json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
